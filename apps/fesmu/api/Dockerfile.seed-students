FROM golang:1.26-alpine AS build

WORKDIR /src
COPY packages/go packages/go
COPY apps/fesmu/api apps/fesmu/api
WORKDIR /src/apps/fesmu/api

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/seed-students ./cmd/seed-students

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=build /out/seed-students ./seed-students
ENTRYPOINT ["./seed-students"]
