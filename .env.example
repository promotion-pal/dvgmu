# Локальная база тикетов (docker compose)
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=dvgmu_tickets_db
POSTGRES_PORT=5446

# Порт gRPC-Web API тикетов для фронтенда
TICKETS_GRPC_PORT=4050
VITE_API_URL=http://localhost:4050

# Локальная база и API MDM
MDM_POSTGRES_USER=root
MDM_POSTGRES_PASSWORD=password
MDM_POSTGRES_DB=dvgmu_mdm_db
MDM_POSTGRES_PORT=5447
MDM_GRPC_PORT=4051
VITE_MDM_API_URL=http://localhost:4051

TASKS_POSTGRES_USER=root
TASKS_POSTGRES_PASSWORD=password
TASKS_POSTGRES_DB=dvgmu_tasks_db
TASKS_POSTGRES_PORT=5448
TASKS_GRPC_PORT=4052

# Подключение к Postgres для production compose
POSTGRES_HOST=dvgmu_apps_ticket_db
