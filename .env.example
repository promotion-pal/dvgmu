# Локальная БД Tickets
TICKETS_DB_USER=root
TICKETS_DB_PASSWORD=password
TICKETS_DB_NAME=dvgmu_tickets_db
TICKETS_DB_PORT=5446
TICKETS_DB_HOST=dvgmu_apps_ticket_db
TICKETS_MDM_URL=http://dvgmu_mdm_api:4000
TICKETS_DEV_MDM_URL=http://host.docker.internal:4051

# Порт gRPC-Web API тикетов для фронтенда
TICKETS_GRPC_PORT=4050
VITE_GATEWAY_URL=

# Локальная БД и API MDM
MDM_DB_USER=root
MDM_DB_PASSWORD=password
MDM_DB_NAME=dvgmu_mdm_db
MDM_DB_PORT=5447
MDM_DB_HOST=dvgmu_mdm_db
MDM_GRPC_PORT=4051
AUTH_MDM_URL=http://host.docker.internal:4051

# Локальная БД Auth с тестовыми учетными записями
AUTH_DB_USER=root
AUTH_DB_PASSWORD=password
AUTH_DB_NAME=dvgmu_auth_db
AUTH_DB_PORT=5448
AUTH_PROVIDER=test-db
# Fill these values to provision a local test account in Auth
AUTH_TEST_USER_ID=
AUTH_TEST_EMAIL=
AUTH_TEST_PASSWORD=

# API Gateway и Auth (сгенерируйте случайный секрет минимум из 32 байт)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
GATEWAY_SHARED_SECRET=replace-with-a-different-random-secret-of-at-least-32-bytes
INTERNAL_SERVICE_TOKEN=replace-with-another-random-secret-of-at-least-32-bytes
AUTH_PORT=4053
GATEWAY_PORT=4052
GATEWAY_AUTH_URL=http://host.docker.internal:4053
GATEWAY_MDM_URL=http://host.docker.internal:4051
GATEWAY_TICKETS_URL=http://host.docker.internal:4050
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
GATEWAY_PROD_ALLOWED_ORIGINS=https://lk.dvgmu.promotion-pal.ru
GATEWAY_DOMAIN=lk.dvgmu.promotion-pal.ru
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
