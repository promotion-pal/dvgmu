# ─────────────────────────────────────────────────────────────
#  file — cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=file
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dvgmu_apps_file_db

# Имя контейнера БД в prod (= container_name у dvgmu_apps_file_db).
POSTGRES_HOST=dvgmu_apps_file_db

# CORS: домены для cross-origin (через запятую). Нужен только если сервис
# дёргают напрямую из браузера — при межсервисных вызовах внутри docker-сети
# не требуется.
FILE_CORS_ALLOWED_ORIGINS=

FILE_TZ=Asia/Vladivostok
