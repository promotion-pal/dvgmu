# ─────────────────────────────────────────────────────────────
#  dormitory — cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=dormitory
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dvgmu_dormitory_db

# Имя контейнера БД в prod (= container_name у dvgmu_apps_dormitory_db).
POSTGRES_HOST=dvgmu_apps_dormitory_db

# CORS: домены для cross-origin (через запятую). Основной путь — same-origin:
# браузер бьёт на https://dormitory.dvgmu.promotion-pal.ru/api/*, Next проксирует внутрь.
DORMITORY_CORS_ALLOWED_ORIGINS=https://dormitory.dvgmu.promotion-pal.ru

# Пароль админ-панели: один и тот же для фронта (вкомпилируется) и бэка
# (проверяется на правках записей).
DORMITORY_ADMIN_PASSWORD=change-me

DORMITORY_TZ=Asia/Vladivostok
