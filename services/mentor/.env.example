# ─────────────────────────────────────────────────────────────
#  mentor — cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=mentor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dvgmu_mentor_db

# Имя контейнера БД в prod (= container_name у dvgmu_apps_mentor_db).
POSTGRES_HOST=dvgmu_apps_mentor_db

# CORS: домены для cross-origin (через запятую). Основной путь — same-origin:
# браузер бьёт на https://mentor.dvgmu.promotion-pal.ru/api/*, Next проксирует внутрь.
MENTOR_CORS_ALLOWED_ORIGINS=https://mentor.dvgmu.promotion-pal.ru

MENTOR_TZ=Asia/Vladivostok
