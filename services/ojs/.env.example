# ─────────────────────────────────────────────────────────────
#  OJS deployment – used by docker-compose.yaml (domain / Traefik)
#  Copy to .env and fill in real values before `docker compose up -d`.
#  Local run without a domain:  docker compose -f docker-compose.dev.yaml up -d
# ─────────────────────────────────────────────────────────────

# Public domain. Must match base_url + allowed_hosts + [oai] repository_id
# in config/config.inc.php
OJS_DOMAIN=journal.dvgmu.promotion-pal.ru

# Image tag. "latest" = newest OJS; pin for reproducible deploys, e.g. 3_5_0-5
OJS_IMAGE_TAG=3_5_0-5

# ── Database ──────────────────────────────────────────────────
# NOTE: these apply only to a FRESH db volume. If you change the password
#       here you must also change it in config/config.inc.php ([database] password).
DB_NAME=ojs
DB_USER=ojs
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# ── Traefik ───────────────────────────────────────────────────
# External Docker network your Traefik instance is attached to.
# Check with:  docker network ls   (server bibl-03: traefik-network)
TRAEFIK_NETWORK=traefik-network

# Entrypoint names as defined in your Traefik static config
# (HTTPS entrypoint / HTTP entrypoint used for the →HTTPS redirect)
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_ENTRYPOINT_HTTP=web

# ACME/Let's Encrypt cert resolver name from your Traefik static config
TRAEFIK_CERTRESOLVER=le
