TZ=Asia/Vladivostok

# Тот же read-only LDAP-бинд, что уже настроен у services/auth (AUTH_LDAP_*).
LDAP_URL=ldap://112.121.288.676:389
LDAP_BASE_DN=DC=test,DC=local
LDAP_BIND_DN=test@dvgmu.local
LDAP_BIND_PASSWORD=change-me

# curl -X POST https://oauth.yandex.ru/token \
#   -d "grant_type=client_credentials&client_id=<ClientID>&client_secret=<Client secret>"
SCIM_BEARER_TOKEN=change-me

# admin.yandex.ru -> Общие настройки -> Единый вход (SSO) -> Настроить
SCIM_DOMAIN_ID=change-me

# true — ничего не меняет в Yandex 360, только логирует, что было бы сделано.
# Обязательно оставить true на первый запуск.
SCIM_DRY_RUN=true

SCIM_INTERVAL_MINUTES=60
