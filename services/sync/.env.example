SYNC_INTERVAL=1h

MDM_SERVICE_URL=http://dvgmu_apps_mdm_api:4000

AUTH_LDAP_URL=ldap://192.168.2.222:389
AUTH_LDAP_START_TLS=false
AUTH_LDAP_INSECURE_SKIP_VERIFY=true
AUTH_LDAP_BIND_DN=ldapuser@dvgmu.local
AUTH_LDAP_BIND_PASSWORD=change-me
AUTH_LDAP_BASE_DN=DC=dvgmu,DC=local

# тот же секрет, что MDM_INTERNAL_TOKEN в services/mdm/.env — для записи связок
MDM_INTERNAL_TOKEN=change-me

SYNC_LDAP_WRITE_URL=ldap://192.168.2.222:389
SYNC_LDAP_WRITE_INSECURE_SKIP_VERIFY=false
SYNC_LDAP_WRITE_BIND_DN=change-me
SYNC_LDAP_WRITE_BIND_PASSWORD=change-me

SYNC_LDAP_TARGET_OU=OU=Test,DC=dvgmu,DC=local
SYNC_LDAP_UPN_SUFFIX=dvgmu.local