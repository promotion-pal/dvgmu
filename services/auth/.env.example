GRPC_PORT=4041
# CORS-источники через запятую, без пробелов. Здесь же фронты, которые зовут
# /api/v1/auth/* с cookie (напр. https://core.fesmu.ru).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://auth.dvgmu.promotion-pal.ru

# Защищает служебные RPC IdentityService от вызова снаружи.
AUTH_INTERNAL_TOKEN=change-me

# ── БД: identities (журнал входов), refresh_tokens ─────────────────────────
# Пустой AUTH_DB_NAME → БД не поднимается, токены fesmu не выдаются.
# Хост БД в docker задаёт compose (auth_db), AUTH_DB_HOST — только для локального запуска.
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=change-me
AUTH_DB_NAME=auth
AUTH_DB_SSLMODE=disable

# ── Вход через AD: проверка пароля в AD FS (WS-Trust) ───────────────────────
AUTH_ADFS_WSTRUST_URL=https://dvgmu-ad.dvgmu.local/adfs/services/trust/13/usernamemixed
# Идентификатор Relying Party Trust, заведённого в AD FS.
AUTH_ADFS_RELYING_PARTY_ID=https://auth.dvgmu.promotion-pal.ru/saml/idp/metadata
AUTH_ADFS_UPN_SUFFIX=dvgmu.local
AUTH_ADFS_INSECURE_SKIP_VERIFY=true
AUTH_ADFS_OBJECT_GUID_CLAIM=
AUTH_ADFS_SIGNING_CERT_PEM=

# LDAP: objectGUID/UPN по логину, если AD FS их не прислал.
AUTH_LDAP_URL=ldap://192.168.2.222:389
AUTH_LDAP_BIND_DN=ldapuser@dvgmu.local
AUTH_LDAP_BIND_PASSWORD=change-me
AUTH_LDAP_BASE_DN=DC=dvgmu,DC=local

# ── SAML IdP для Yandex 360 и форма /login ─────────────────────────────────
AUTH_SAML_IDP_BASE_URL=https://auth.dvgmu.promotion-pal.ru
AUTH_SAML_IDP_ENTITY_ID=https://auth.dvgmu.promotion-pal.ru/saml/idp/metadata
# Сертификат/ключ подписи SAML-ответов — НЕ менять: его знает Yandex 360.
AUTH_SAML_IDP_CERT_PEM=
AUTH_SAML_IDP_KEY_PEM=
AUTH_SAML_IDP_EMAIL_DOMAIN=fesmu.ru
# SSO-сессия IdP (у всех, кто вошёл через AD).
AUTH_JWT_SECRET=change-me
AUTH_SAML_IDP_COOKIE_DOMAIN=.dvgmu.promotion-pal.ru
# Куда /login может вернуть после входа.
AUTH_LOGIN_ALLOWED_RETURN_HOSTS=core.fesmu.ru
AUTH_LOGIN_DEFAULT_RETURN_URL=https://core.fesmu.ru/

# ── Токены fesmu (только для связанных с MDM) ──────────────────────────────
# В docker адрес mdm задаёт compose по STAND — здесь только для локального запуска.
AUTH_MDM_SERVICE_URL=http://localhost:4004
# Ed25519, одной строкой с \n:
#   openssl genpkey -algorithm ed25519 | awk '{printf "%s\\n", $0}'
# Пусто — ключ генерируется при старте (токены умирают при рестарте).
AUTH_JWT_SIGNING_KEY_PEM=
# Домен access-cookie: должен покрывать api фронта (api.core.fesmu.ru).
AUTH_COOKIE_DOMAIN=.fesmu.ru
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h

# ── Активация кодом и смена пароля (/activate, /password) ──────────────────
# Тот же секрет, что MDM_INTERNAL_TOKEN у mdm: проверка кодов активации.
AUTH_MDM_INTERNAL_TOKEN=change-me
# Служебная учётка с правом «Сброс пароля» на OU пользователей. Только LDAPS:
# по открытому LDAP AD пароль не меняет. Пусто — страницы «временно недоступны».
AUTH_LDAP_PWD_URL=ldaps://dvgmu-ad.dvgmu.local:636
AUTH_LDAP_PWD_BIND_DN=svc-auth-pwd@dvgmu.local
AUTH_LDAP_PWD_BIND_PASSWORD=change-me
AUTH_LDAP_PWD_INSECURE_SKIP_VERIFY=true

# ── Смена пароля пользователем (/password) ─────────────────────────────────
# Kerberos kpasswd от имени самого пользователя: служебная учётка и LDAPS не
# нужны, нужны 88/tcp и 464/tcp до контроллера домена. Сюда же форма входа
# ведёт тех, у кого в AD «сменить пароль при следующем входе» (проверка —
# чтением pwdLastSet учёткой AUTH_LDAP_*, без попытки входа). Пусто — заглушка.
AUTH_KRB_REALM=DVGMU.LOCAL
AUTH_KRB_KDC=dvgmu-ad.dvgmu.local:88
AUTH_KRB_KPASSWD=dvgmu-ad.dvgmu.local:464

# Временный вход на уже открытом домене (пока сетевой фильтр не пропускает
# AUTH_DOMAIN): /login, /saml/, /api/v1/auth/… отдаются и на этом хосте.
# Тогда AUTH_SAML_IDP_BASE_URL=https://<этот хост>, а у fesmu VITE_AUTH_URL — он же.
# AUTH_PATH_HOST=core.fesmu.ru
