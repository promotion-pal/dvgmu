# ─────────────────────────────────────────────────────────────
#  analytics — cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=analytic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dvgmu_analytics_db

# Имя контейнера БД в prod (= container_name у dvgmu_apps_analytic_db).
POSTGRES_HOST=dvgmu_apps_analytic_db

# Минимальный интервал (сек) между двумя оценками одного QR с одного IP.
# 0 — проверка по IP отключена (сейчас так). Включить: напр. 172800 (48 ч).
ANALYTIC_REEVALUATION=0

ANALYTIC_TZ=Asia/Vladivostok
